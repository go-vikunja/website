---
import {type MarkdownHeading} from 'astro'
import {getCollection} from 'astro:content'

import Layout from './Layout.astro'
import Prose from '../components/Prose.astro'
import TableOfContents from '../components/TableOfContents.astro'
import SearchButton from '../components/SearchButton.astro'
import SearchModal from '../components/SearchModal.astro'
import CopyMarkdownButton from '../components/CopyMarkdownButton.astro'

interface Props {
	title: string
	headings: MarkdownHeading[]
}

const {title: originalTitle, headings} = Astro.props
// @ts-ignore: Property exists
const title = originalTitle ?? Astro.props.frontmatter?.title
// @ts-ignore: Property exists
const description = Astro.props?.frontmatter?.description || Astro.props.description

interface SectionItem {
	url: string;
	title: string;
}

async function getSidebarNavigation(): Promise<SectionItem[]> {
	const help = await getCollection('help')

	return help
		.filter(d => !d.data.hideInMenu)
		.map(d => ({
			url: '/help/' + d.id,
			title: d.data.title,
		}))
		.sort((a, b) => a.title.localeCompare(b.title))
}

const sidebarEntries = await getSidebarNavigation()
---
<Layout title={title} description={description}>
    <SearchModal />

    <div class="mx-auto flex max-w-(--breakpoint-2xl) flex-col lg:flex-row lg:pt-8">
        <!-- Search Button (fixed position on mobile) -->
        <div class="fixed bottom-4 right-4 z-40 lg:hidden">
            <SearchButton />
        </div>

        <button
                class="navbar-burger m-2 mt-6 block lg:hidden rounded-xs bg-gray-200 dark:bg-gray-800 py-2 px-1 text-center"
                data-target="helpMenu"
        >
            Toggle Menu
        </button>
        <aside class="w-full lg:w-1/5 hidden lg:block order-1 px-2 text-gray-600 dark:text-gray-300" id="helpMenu">
            <!-- Search Button for desktop (in sidebar) -->
            <div class="pb-4 pt-2">
                <SearchButton />
            </div>

            <nav class="pb-4">
                <ul>
                    <li>
                        <a
                                href="/help"
                                class={'block rounded-sm px-2 py-1.5 hover:bg-gray-200 dark:hover:bg-gray-800 transition ' + ((Astro.url.pathname === '/help' || Astro.url.pathname === '/help/') && ' bg-gray-100! dark:bg-gray-800! text-primary')}
                        >
                            Help overview
                        </a>
                    </li>
                    {sidebarEntries.map(item => (
                            <li>
                                <a
                                        href={item.url}
                                        class={'block rounded-sm px-2 py-1.5 hover:bg-gray-200 dark:hover:bg-gray-800 transition ' + ((Astro.url.pathname === item.url || Astro.url.pathname === item.url + '/') && ' bg-gray-100! dark:bg-gray-800! text-primary')}
                                >
                                    {item.title}
                                </a>
                            </li>
                    ))}
                </ul>
            </nav>
        </aside>
        <main class="w-full lg:w-3/5 p-4 pt-6 lg:pt-2 order-3 lg:order-2" id="main-content">
            <Prose>
                <header class="not-prose mb-8">
                    <h1 class="font-display text-4xl font-bold text-gray-900 dark:text-gray-100">{title}</h1>
                    {description && (
                        <p class="mt-3 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300">
                            {description}
                        </p>
                    )}
                </header>
                <slot/>
            </Prose>
        </main>
        <div class="w-full lg:w-1/5 pl-4 order-2 lg:order-3">
                <div class="mb-4 pt-2">
                    <CopyMarkdownButton />
                </div>
            <TableOfContents headings={headings}/>
        </div>
    </div>
</Layout>

<script>
  import { initializeSearchUI } from '../scripts/search-ui'

  document.addEventListener('DOMContentLoaded', () => {
    initializeSearchUI()
  })
</script>
