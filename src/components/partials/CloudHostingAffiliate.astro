---
import Trans from '../Trans.astro'
import {useTranslations} from '../../i18n'
import {parsePathname} from '../../i18n/routes'

const t = useTranslations(parsePathname(Astro.url.pathname).locale)
---
<div class="border border-primary px-6 rounded">
    <h2 id="getting-a-server-to-host-vikunja-on" class="mt-6">
        {t('cloudHostingAffiliate.title')}
    </h2>

    <p>
        <Trans message="cloudHostingAffiliate.cloud">
            <a slot="cloudLink" href="https://app.vikunja.cloud/?redirectToProvider=true">Vikunja Cloud</a>
        </Trans>
    </p>

    <p>
        {t('cloudHostingAffiliate.control')}
    </p>

    <p>{t('cloudHostingAffiliate.recommend')}</p>
    <ul>
        <li>
            <Trans message="cloudHostingAffiliate.hetzner">
                <a slot="provider" href="https://hetzner.cloud/?ref=rftnSU8lrkmT">Hetzner</a>
                <a slot="ourLink" href="https://hetzner.cloud/?ref=rftnSU8lrkmT">{t('cloudHostingAffiliate.ourLink')}</a>
            </Trans>
        </li>
        <li>
            <Trans message="cloudHostingAffiliate.digitalOcean">
                <a slot="provider" href="https://m.do.co/c/2d0f6efa8d5c">Digital Ocean</a>
                <a slot="ourLink" href="https://m.do.co/c/2d0f6efa8d5c">{t('cloudHostingAffiliate.ourLink')}</a>
            </Trans>
        </li>
    </ul>

    <p>{t('cloudHostingAffiliate.disclaimer')}</p>

</div>
