---
import Button from '../Button.astro'
import Trans from '../Trans.astro'
import {VIKUNJA_CLOUD_LINK} from '../../helpers/vikunjaCloudLink'
import {useTranslations} from '../../i18n'
import {localizedHref, parsePathname} from '../../i18n/routes'

interface Props {
	showTitle?: boolean
}

const {showTitle = true} = Astro.props
const {locale} = parsePathname(Astro.url.pathname)
const t = useTranslations(locale)

interface Plan {
	title: string
	priceMonthly: number
	priceYearly: number
	priceDifferencePercent: number
	description: string
	priceSuffix?: string
	features: string[]
}

const communitySupport = `<a class="underline" href="https://community.vikunja.io/" target="_blank" rel="noopener">${t('plans.feature.communitySupport')}</a>`

const plans: Plan[] = [
	{
		title: t('plans.personal.title'),
		priceMonthly: 4,
		priceYearly: 40,
		priceDifferencePercent: 20,
		description: t('plans.personal.description'),
		features: [
			t('plans.feature.unlimitedLists'),
			t('plans.feature.unlimitedTasks'),
			t('plans.feature.unlimitedReminders'),
			t('plans.feature.unlimitedShareLinks'),
			t('plans.feature.unlimitedRelations'),
			t('plans.feature.unlimitedFilters'),
			t('plans.feature.storage', {size: '10GB'}),
			t('plans.feature.supportProject'),
			t('plans.feature.emailAndCommunitySupport', {communitySupport}),
		],
	},
	{
		title: t('plans.family.title'),
		priceMonthly: 10,
		priceYearly: 99,
		priceDifferencePercent: 17.5,
		description: t('plans.family.description'),
		priceSuffix: t('plans.family.priceSuffix'),
		features: [
			t('plans.feature.everythingInPersonal'),
			t('plans.feature.upTo5Users'),
			t('plans.feature.sharedProjects'),
			t('plans.feature.oneSubscription'),
		],
	},
	{
		title: t('plans.organization.title'),
		priceMonthly: 5,
		priceYearly: 50,
		priceDifferencePercent: 20,
		description: t('plans.organization.description'),
		priceSuffix: t('plans.organization.priceSuffix'),
		features: [
			t('plans.feature.everythingInPersonal'),
			t('plans.feature.unlimitedTeams'),
			t('plans.feature.storage', {size: '50GB'}),
			t('plans.feature.prioritySupport'),
			t('plans.feature.teamBilling'),
		],
	},
]
---
<section class="mt-12">
	{showTitle ? <h2 class="font-display text-4xl mb-4" id="pricing">{t('nav.pricing')}</h2> : ''}

    <div class="flex flex-col md:flex-row my-0 mx-auto md:space-x-4">
		{plans.map((p: Plan) => (
                <article class="border border-gray-50 dark:border-gray-900 rounded-sm p-8 w-full md:w-1/4 bg-white dark:bg-gray-800 text-left mt-4 flex flex-col">
                    <div class="h-48 shrink-0 flex flex-col justify-between">
                        <div>
                            <div class="font-display text-xl mb-2">
								{p.title}
                            </div>
                            <div class="font-display mb-2">
                                <span class="text-3xl">{p.priceMonthly}€</span>
                                /&nbsp;{t('plans.month')}
								{p.priceSuffix ?? ''}
                            </div>
                            <p class="text-sm mb-4 text-gray-500 dark:text-gray-400">
								{t('plans.billedYearly', {price: p.priceYearly.toLocaleString(locale), percent: p.priceDifferencePercent.toLocaleString(locale)})}
                            </p>
                        </div>

                        <p class="text-gray-700 dark:text-gray-300 pb-4">
							{p.description}
                        </p>
                    </div>

                    <hr class="mb-4"/>

                    <div class="flex flex-col justify-between h-full">

                        <ul class="list-disc list-checkmark pl-4 mb-6 text-gray-700 dark:text-gray-300">
							{p.features.map(f => (
                                    <li><Fragment set:html={f}/></li>
							))}
                        </ul>

                        <div>
                            <Button href={VIKUNJA_CLOUD_LINK}>
                                {t('plans.buy')}
                            </Button>
                            <p class="text-sm text-gray-500 dark:text-gray-400 block mt-2">
                                {t('plans.trial')}
                            </p>
                        </div>
                    </div>
                </article>))}

        <article class="border border-gray-50 dark:border-gray-900 rounded-sm p-8 w-full md:w-1/4 bg-white dark:bg-gray-800 text-left mt-4 flex flex-col">
            <div class="h-48 shrink-0 flex flex-col justify-between">
                <div>
                    <div class="font-display text-xl mb-2">
                        Pro
                    </div>
                    <div class="font-display mb-4 text-2xl">
                        {t('plans.pro.plans')}
                    </div>
                </div>

                <p class="text-gray-700 dark:text-gray-300 pb-4">
                    {t('plans.pro.description')}
                </p>
            </div>

            <hr class="mb-4"/>

            <div class="flex flex-col justify-between h-full">

                <ul class="list-disc list-checkmark pl-4 mb-6 text-gray-700 dark:text-gray-300">
                    <li>{t('pro.feature.adminPanel')}</li>
                    <li>{t('pro.feature.auditLogs')}</li>
                    <li>{t('pro.feature.timeTracking')}</li>
                    <li>{t('plans.pro.selfHosted')}</li>
                    <li>{t('plans.pro.allPlans')}</li>
                </ul>

                <div>
                    <Button href={localizedHref(locale, '/pro')}>
                        {t('plans.pro.learnMore')}
                    </Button>
                    <p class="text-sm text-gray-500 dark:text-gray-400 block mt-2">
                        {t('plans.pro.beta')}
                    </p>
                </div>
            </div>
        </article>
    </div>

    <p class="pt-8 text-gray-600 dark:text-gray-300">
        <Trans message="plans.openSource">
            <a slot="openSource" href="https://vikunja.io/" class="underline" target="_blank" rel="noopener">{t('plans.openSourceLink')}</a>
        </Trans><br/>
        {t('plans.hostedSupports')}
    </p>

    <section class="max-w-xl mx-auto text-left">
        <h2 class="font-display mt-12 mb-4 text-xl">{t('plans.whyNoFree.title')}</h2>
        <p>
            <Trans message="plans.whyNoFree.cost">
                <em slot="somewhere">{t('plans.whyNoFree.somewhere')}</em>
            </Trans>
        </p>
        <p class="mt-2">
            {t('plans.whyNoFree.notUs')}<br/>
            {t('plans.whyNoFree.userFirst')}
        </p>
        <p class="mt-2">
            <Trans message="plans.whyNoFree.trial">
                <a slot="reachOut" class="underline" href="mailto:hello@vikunja.io">{t('plans.whyNoFree.reachOut')}</a>
            </Trans>
        </p>
    </section>
</section>
