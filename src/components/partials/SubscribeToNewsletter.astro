---
import Button from '../Button.astro'
import type {NewsletterList} from '../../helpers/newsletter'

interface Props {
	defaultList?: NewsletterList
}

const {defaultList = 'news'} = Astro.props
---

<div data-newsletter="signup">
    <p class="font-display text-base font-bold">Subscribe to our newsletter</p>
    <p class="mt-2">
        We'll email you about releases and news about Vikunja. Low traffic. Unsubscribe any
        time.
    </p>

    <form method="post" action="" class="mt-4! w-ful">
        <p>
            <label>
                <span class="sr-only">Your mail address</span>
                <input
                        name="email"
                        required
                        type="email"
                        placeholder="Your mail address"
                        class="inline-flex relative justify-start items-center py-2 px-3 m-0 w-full max-w-full h-10 font-sans text-base leading-normal align-top bg-white dark:bg-gray-800 rounded-sm border border-solid appearance-none cursor-text border-gray-300 dark:border-gray-700 text-neutral-700 dark:text-gray-200"
                />
            </label>
        </p>

        <fieldset class="mt-2 flex flex-col gap-1">
            <legend class="sr-only">What do you want to receive?</legend>
            <label class="flex items-center gap-2">
                <input type="checkbox" name="list" value="news" checked={defaultList === 'news'} class="text-primary">
                Releases and news
            </label>
            <label class="flex items-center gap-2">
                <input type="checkbox" name="list" value="security" checked={defaultList === 'security'} class="text-primary">
                Security announcements
            </label>
        </fieldset>

        <div class="cf-turnstile" data-sitekey="0x4AAAAAAABNSP6TBlZ-SPeg" data-theme="light"></div>

        <p data-newsletter="error" class="hidden text-red-500"></p>

        <Button
                class="mt-2! w-full"
                type="submit"
        >
            Subscribe to our newsletter
        </Button>

        <p class="mt-2 text-sm text-neutral-500 dark:text-gray-400">
            By clicking &ldquo;Subscribe to our newsletter&rdquo;, you consent to us sending you our
            newsletter on a regular basis. You can withdraw your consent at any time. For more
            information, please see our <a href="/privacy" class="underline">Privacy Policy</a>.
        </p>
    </form>

    <p class="text-green-500 hidden pt-2" data-newsletter="success">
        Success! We've sent you a message to confirm your sign up.
    </p>
</div>

<style>
    @reference '../../styles/global.css';

    .cf-turnstile {
        @apply w-full mt-2
    }
</style>

<script>
	let scriptLoaded = false

	function loadTurnstile() {
		if (!scriptLoaded) {
			const script = document.createElement('script')
			script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js'
			script.async = true
			document.head.appendChild(script)
			scriptLoaded = true
		}
	}

	document.querySelectorAll('[data-newsletter="signup"]').forEach(signup => {
		const form = signup.querySelector('form')
		const errorMessage = signup.querySelector('[data-newsletter="error"]')
		const successMessage = signup.querySelector('[data-newsletter="success"]')

		if (!form || !errorMessage || !successMessage) {
			return
		}

		form.addEventListener('focusin', loadTurnstile)

		const listCheckboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="list"]'))

		function validateLists() {
			const anyChecked = listCheckboxes.some(checkbox => checkbox.checked)
			listCheckboxes[0]?.setCustomValidity(anyChecked ? '' : 'Please select at least one newsletter.')
		}

		listCheckboxes.forEach(checkbox => checkbox.addEventListener('change', validateLists))
		validateLists()

		function showError(error: string) {
			if (errorMessage) {
				errorMessage.textContent = 'An error occurred: ' + error + ' Please try again.'
				errorMessage.classList.remove('hidden')
			}
			console.error('Error during newsletter sign up:', error)
		}

		form.addEventListener('submit', function (e) {
			e.preventDefault()

			const formData = new FormData(form)

			fetch('/api/newsletter-signup', {
				method: 'POST',
				body: formData,
			})
				.then(response => {
					if (!response.ok) {
						return response.json().then(error => {
							throw new Error(error?.message || error)
						})
					}

					errorMessage.classList.add('hidden')
					successMessage.classList.toggle('hidden')
					form.classList.add('hidden')
				})
				.catch(error => showError(error))
		})
	})
</script>
