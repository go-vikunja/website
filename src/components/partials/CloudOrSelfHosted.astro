---
import Button from '../Button.astro'
import {VIKUNJA_CLOUD_LINK} from '../../helpers/vikunjaCloudLink'
import {useTranslations} from '../../i18n'
import {localizedHref, parsePathname} from '../../i18n/routes'

const {locale} = parsePathname(Astro.url.pathname)
const t = useTranslations(locale)
---
<div class="flex flex-col lg:flex-row items-center justify-center gap-8 mb-28">
    <div class="lg:w-1/3">
        <p class="text-balance">
            {t('cloudOrSelfHosted.selfHost')}
        </p>

        <Button href={localizedHref(locale, '/install')} class="mt-4!">
            {t('cloudOrSelfHosted.getStarted')}
        </Button>
    </div>

    <div class="border-2 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 rounded-full p-2 text-sm">
        {t('cloudOrSelfHosted.or')}
    </div>

    <div class="lg:w-1/3">
        <p class="text-balance">
            {t('cloudOrSelfHosted.noServer')}
        </p>

        <Button href={VIKUNJA_CLOUD_LINK} class="mt-4!">
            {t('cloudOrSelfHosted.meetCloud')}
        </Button>
    </div>
</div>
