---
import Callout from './Callout.astro'
import Trans from './Trans.astro'
import {isReleased} from '../helpers/releases'
import {useTranslations} from '../i18n'
import {parsePathname} from '../i18n/routes'

interface Props {
	version: string
}

const {version} = Astro.props
const released = await isReleased(version)
const t = useTranslations(parsePathname(Astro.url.pathname).locale)
const feature = Astro.slots.has('default')
	? await Astro.slots.render('default')
	: t('availableFrom.thisFeature').replace(/&/g, '&amp;').replace(/</g, '&lt;')
---

<Callout type="info">
	<p>
		<Trans message={released ? 'availableFrom.released' : 'availableFrom.unreleased'}>
			<Fragment slot="feature" set:html={feature}/>
			<strong slot="version">{version}</strong>
			<a slot="unstable" href="/docs/versions">{t('availableFrom.unstableBuilds')}</a>
		</Trans>
	</p>
</Callout>
