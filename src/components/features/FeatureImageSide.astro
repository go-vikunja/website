---
import Screenshot from '../Screenshot.astro'

interface Props {
	image: any,
	darkImage?: any,
	orientation?: 'right' | 'left'
    alt: string
}

const {image, darkImage, orientation: origOrientation, alt} = Astro.props

const orientation = origOrientation ?? 'right'
---
<div class={'flex flex-col items-center text-left gap-6 md:gap-8 mt-8 mb-16 md:mb-32 ' + (orientation === 'left' ? 'md:flex-row-reverse' : 'md:flex-row')}>
    <div class={'w-full md:w-1/2 ' + (orientation === 'left' ? 'md:pr-4' : 'md:pl-4')}>
        <slot/>
    </div>
    <div class="w-full md:w-1/2">
        <Screenshot
            src={image}
            darkSrc={darkImage}
            class="object-contain object-top w-full"
            alt={alt}
        />
    </div>
</div>
