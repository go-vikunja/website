---
import Layout from '../../../layouts/Layout.astro'
import CloudOrSelfHosted from '../../partials/CloudOrSelfHosted.astro'
import FAQSection from '../../FAQSection.astro'
import Trans from '../../Trans.astro'
import {VIKUNJA_CLOUD_LINK} from '../../../helpers/vikunjaCloudLink'
import {useTranslations} from '../../../i18n'
import {localizedHref, parsePathname} from '../../../i18n/routes'

const {locale} = parsePathname(Astro.url.pathname)
const t = useTranslations(locale)
const pricingHref = localizedHref(locale, '/pricing')

const faqLinks = {
    importUrl: localizedHref(locale, '/help/import-and-export/#import'),
    quickAddUrl: localizedHref(locale, '/help/quick-add-magic'),
    remindersUrl: localizedHref(locale, '/help/dates-and-reminders'),
}
const faqs = (['import', 'quickAdd', 'reminders', 'mobile'] as const).map(id => ({
    question: t(`compare.todoist.faq.${id}.question`),
    answer: t(`compare.todoist.faq.${id}.answer`, faqLinks),
}))
---
<Layout title={t('compare.todoist.title')} description={t('compare.todoist.description')}>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": t('footer.compare', {name: 'Todoist'}),
            "description": t('compare.common.schemaDescription', {name: 'Todoist'}),
        })}></script>
    </Fragment>
    <main class="max-w-(--breakpoint-xl) mx-auto px-4 md:px-0" id="main-content">
        <div class="pt-32 pb-8 px-4 text-center">
            <h1 class="text-4xl font-display">
                {t('footer.compare', {name: 'Todoist'})}
            </h1>
            <p class="mt-4 text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-balance">
                {t('compare.todoist.subtitle')}
            </p>
        </div>

        <section class="max-w-3xl mx-auto mt-16 text-lg text-gray-700 dark:text-gray-300">
            <p>
                {t('compare.todoist.intro1')}
            </p>
            <p class="mt-4">
                <Trans message="compare.todoist.intro2">
                    <a slot="limits" href="https://www.todoist.com/help/articles/usage-limits-in-todoist-e5rcSY" target="_blank" rel="nofollow noreferrer noopener" class="underline">{t('compare.todoist.intro2Limits')}</a>
                </Trans>
            </p>
            <p class="mt-4">
                {t('compare.todoist.intro3')}
            </p>
            <p class="mt-4">
                <Trans message="compare.todoist.intro4">
                    <a slot="cloud" href={VIKUNJA_CLOUD_LINK} class="underline">Vikunja Cloud</a>
                </Trans>
            </p>
        </section>

        <section class="max-w-4xl mx-auto mt-20">
            <h2 class="font-display text-3xl mb-4">{t('compare.todoist.extras.title')}</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-8">
                {t('compare.todoist.extras.intro')}
            </p>
            <div class="max-w-3xl text-gray-700 dark:text-gray-300 space-y-6">
                <div>
                    <h3 class="font-display text-xl">{t('compare.todoist.extras.views.title')}</h3>
                    <p class="mt-2">
                        <Trans message="compare.todoist.extras.views.text">
                            <a slot="views" href={localizedHref(locale, '/help/views')} class="underline">{t('compare.todoist.extras.views.link')}</a>
                        </Trans>
                    </p>
                </div>
                <div>
                    <h3 class="font-display text-xl">{t('compare.todoist.extras.caldav.title')}</h3>
                    <p class="mt-2">
                        <Trans message="compare.todoist.extras.caldav.text">
                            <a slot="caldav" href={localizedHref(locale, '/help/caldav')} class="underline">CalDAV</a>
                        </Trans>
                    </p>
                </div>
                <div>
                    <h3 class="font-display text-xl">{t('compare.todoist.extras.limits.title')}</h3>
                    <p class="mt-2">
                        <Trans message="compare.todoist.extras.limits.text">
                            <a slot="projects" href={localizedHref(locale, '/help/projects')} class="underline">{t('compare.todoist.extras.limits.projects')}</a>
                            <a slot="filters" href={localizedHref(locale, '/help/saved-filters')} class="underline">{t('compare.todoist.extras.limits.filters')}</a>
                            <a slot="labels" href={localizedHref(locale, '/help/labels')} class="underline">{t('compare.todoist.extras.limits.labels')}</a>
                        </Trans>
                    </p>
                </div>
            </div>
        </section>

        <section class="max-w-4xl mx-auto mt-20">
            <h2 class="font-display text-3xl mb-8">{t('compare.common.sideBySide')}</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-gray-200 dark:border-gray-700">
                            <th class="py-3 px-4 font-display text-lg"></th>
                            <th class="py-3 px-4 font-display text-lg">Vikunja</th>
                            <th class="py-3 px-4 font-display text-lg">Todoist</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700 dark:text-gray-300">
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.selfHostable')}</td>
                            <td class="py-3 px-4">{t('compare.common.yes')}</td>
                            <td class="py-3 px-4">{t('compare.common.no')}</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.openSource')}</td>
                            <td class="py-3 px-4">AGPLv3</td>
                            <td class="py-3 px-4">{t('compare.common.no')}</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.views')}</td>
                            <td class="py-3 px-4">{t('compare.common.fourViews')}</td>
                            <td class="py-3 px-4"><a href="https://www.todoist.com/pricing" target="_blank" rel="nofollow noreferrer noopener" class="underline">{t('compare.todoist.table.views')}</a></td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.reminders')}</td>
                            <td class="py-3 px-4">{t('compare.common.allPlans')}</td>
                            <td class="py-3 px-4"><a href="https://www.todoist.com/pricing" target="_blank" rel="nofollow noreferrer noopener" class="underline">{t('compare.common.paidOnly')}</a></td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.todoist.table.projects')}</td>
                            <td class="py-3 px-4">{t('compare.common.unlimited')}</td>
                            <td class="py-3 px-4"><a href="https://www.todoist.com/help/articles/usage-limits-in-todoist-e5rcSY" target="_blank" rel="nofollow noreferrer noopener" class="underline">5</a></td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.todoist.table.tasksPerProject')}</td>
                            <td class="py-3 px-4">{t('compare.common.unlimited')}</td>
                            <td class="py-3 px-4"><a href="https://www.todoist.com/help/articles/usage-limits-in-todoist-e5rcSY" target="_blank" rel="nofollow noreferrer noopener" class="underline">300</a></td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.savedFilters')}</td>
                            <td class="py-3 px-4">{t('compare.common.unlimited')}</td>
                            <td class="py-3 px-4"><a href="https://www.todoist.com/help/articles/usage-limits-in-todoist-e5rcSY" target="_blank" rel="nofollow noreferrer noopener" class="underline">{t('compare.todoist.table.filters')}</a></td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.fileAttachments')}</td>
                            <td class="py-3 px-4">{t('compare.common.yes')}</td>
                            <td class="py-3 px-4"><a href="https://www.todoist.com/pricing" target="_blank" rel="nofollow noreferrer noopener" class="underline">{t('compare.common.paidOnly')}</a></td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.quickAdd')}</td>
                            <td class="py-3 px-4">{t('compare.common.yes')}</td>
                            <td class="py-3 px-4">{t('compare.common.yes')}</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.todoist.table.repeating')}</td>
                            <td class="py-3 px-4">{t('compare.common.yes')}</td>
                            <td class="py-3 px-4">{t('compare.common.yes')}</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">CalDAV</td>
                            <td class="py-3 px-4">{t('compare.common.yes')}</td>
                            <td class="py-3 px-4">{t('compare.common.no')}</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.euDataResidency')}</td>
                            <td class="py-3 px-4">{t('compare.common.euResidency')}</td>
                            <td class="py-3 px-4">{t('compare.common.no')}</td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4 font-medium">{t('compare.common.row.vendorLockIn')}</td>
                            <td class="py-3 px-4">{t('compare.common.noLockIn')}</td>
                            <td class="py-3 px-4"><a href="https://www.todoist.com/help/articles/import-or-export-a-project-as-a-csv-file-in-todoist-YC8YvN" target="_blank" rel="nofollow noreferrer noopener" class="underline">{t('compare.todoist.table.csvOnly')}</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="max-w-3xl mx-auto mt-20">
            <h2 class="font-display text-3xl mb-6">{t('compare.common.pricing')}</h2>
            <p class="text-gray-700 dark:text-gray-300">
                <Trans message="compare.todoist.pricing.text1">
                    <a slot="cloud" href={pricingHref} class="underline">Vikunja Cloud</a>
                </Trans>
            </p>
            <p class="text-gray-700 dark:text-gray-300 mt-4">
                <Trans message="compare.todoist.pricing.text2">
                    <a slot="competitor" href="https://www.todoist.com/pricing" target="_blank" rel="nofollow noreferrer noopener" class="underline">{t('compare.todoist.pricing.competitor')}</a>
                </Trans>
            </p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-4">
                {t('compare.common.pricesAsOf', {name: 'Todoist', site: 'todoist.com'})}
                <Trans message="compare.common.seePricing">
                    <a slot="link" href={pricingHref} class="underline">{t('compare.common.vikunjaPricing')}</a>
                </Trans>
            </p>
        </section>

        <section class="max-w-3xl mx-auto mt-20">
            <h2 class="font-display text-3xl mb-6">{t('compare.common.howToSwitch')}</h2>
            <p class="text-gray-700 dark:text-gray-300">
                {t('compare.todoist.switch.intro')}
            </p>
            <ol class="list-decimal list-inside space-y-3 text-gray-700 dark:text-gray-300 mt-4">
                <li>
                    <Trans message="compare.common.setUp">
                        <a slot="setUp" href={localizedHref(locale, '/install')} class="underline">{t('compare.common.setUpVikunja')}</a>
                        <a slot="cloud" href={VIKUNJA_CLOUD_LINK} class="underline">{t('compare.common.cloudTrial')}</a>
                    </Trans>
                </li>
                <li>{t('compare.todoist.switch.step2')}</li>
                <li>{t('compare.todoist.switch.step3')}</li>
            </ol>
            <p class="text-gray-700 dark:text-gray-300 mt-4">
                {t('compare.todoist.switch.outro')}
            </p>
        </section>

        <FAQSection faqs={faqs} />

        <div class="pb-20 flex items-center justify-center flex-col text-center">
            <h2 class="font-display text-3xl mb-8">{t('compare.common.tryItOut')}</h2>
            <CloudOrSelfHosted />
        </div>
    </main>
</Layout>
