---
import Layout from '../../layouts/Layout.astro'
import Screenshot from '../Screenshot.astro'
import LinkCard from '../LinkCard.astro'
import {VIKUNJA_CLOUD_LINK} from '../../helpers/vikunjaCloudLink'

import VikunjaTaskOverview from '../../assets/images/vikunja/01-task-overview.png'
import VikunjaTaskOverviewDark from '../../assets/images/vikunja/01-task-overview-dark.png'
import VikunjaTaskList from '../../assets/images/vikunja/02-task-list.png'
import VikunjaTaskListDark from '../../assets/images/vikunja/02-task-list-dark.png'
import VikunjaTaskGantt from '../../assets/images/vikunja/03-task-gantt.png'
import VikunjaTaskGanttDark from '../../assets/images/vikunja/03-task-gantt-dark.png'
import VikunjaTaskTable from '../../assets/images/vikunja/04-task-table.png'
import VikunjaTaskTableDark from '../../assets/images/vikunja/04-task-table-dark.png'
import VikunjaTaskKanban from '../../assets/images/vikunja/05-task-kanban.png'
import VikunjaTaskKanbanDark from '../../assets/images/vikunja/05-task-kanban-dark.png'
import VikunjaTaskDetail from '../../assets/images/vikunja/06-task-detail.png'
import VikunjaTaskDetailDark from '../../assets/images/vikunja/06-task-detail-dark.png'
import VikunjaQuickAdd from '../../assets/images/vikunja/07-quick-add.png'
import VikunjaQuickAddDark from '../../assets/images/vikunja/07-quick-add-dark.png'
import VikunjaTaskKanbanBackground from '../../assets/images/vikunja/08-task-kanban-background.png'
import VikunjaTaskKanbanBackgroundDark from '../../assets/images/vikunja/08-task-kanban-background-dark.png'

import HeroLlama1 from '../../assets/images/hero-llamas-small.jpg'
import HeroLlama2 from '../../assets/images/hero-llamas-2-small.jpg'
import HeroLlama3 from '../../assets/images/hero-llamas-3-small.jpg'
import CloudOrSelfHosted from '../partials/CloudOrSelfHosted.astro'
import FAQSection from '../FAQSection.astro'
import Trans from '../Trans.astro'
import {useTranslations} from '../../i18n'
import {localizedHref, parsePathname} from '../../i18n/routes'

const {locale} = parsePathname(Astro.url.pathname)
const t = useTranslations(locale)

const carouselImages = [
	{src: VikunjaTaskOverview, darkSrc: VikunjaTaskOverviewDark, alt: t('home.screenshot.overview')},
	{src: VikunjaTaskList, darkSrc: VikunjaTaskListDark, alt: t('home.screenshot.list')},
	{src: VikunjaTaskGantt, darkSrc: VikunjaTaskGanttDark, alt: t('home.screenshot.gantt')},
	{src: VikunjaTaskTable, darkSrc: VikunjaTaskTableDark, alt: t('home.screenshot.table')},
	{src: VikunjaTaskKanban, darkSrc: VikunjaTaskKanbanDark, alt: t('home.screenshot.kanban')},
	{src: VikunjaTaskDetail, darkSrc: VikunjaTaskDetailDark, alt: t('home.screenshot.detail')},
	{src: VikunjaQuickAdd, darkSrc: VikunjaQuickAddDark, alt: t('home.screenshot.quickAdd')},
	{src: VikunjaTaskKanbanBackground, darkSrc: VikunjaTaskKanbanBackgroundDark, alt: t('home.screenshot.kanbanBackground')},
]
---
<Layout title={t('home.title')} description={t('home.description')}>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "Vikunja",
            "description": t('home.schemaDescription'),
            "applicationCategory": "ProjectManagement",
            "operatingSystem": "Web, Docker, Linux",
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "EUR"
            },
            "license": "https://code.vikunja.io/vikunja/blob/main/LICENSE"
        })}></script>
    </Fragment>
    <main id="main-content">
        <section
                class="flex min-h-screen w-full flex-col items-center justify-center pb-8 text-center text-gray-700 dark:text-gray-300 md:px-0">
            <div class="mt-10 lg:mt-40 mb-20 font-display">
                <h1 class="mb-4 text-5xl tracking-tight text-balance">
                    {t('home.hero.title')}<br/>
                    <span class="text-primary">{t('home.hero.titleHighlight')}</span>
                </h1>
                <h2 class="mx-auto max-w-2xl text-2xl text-balance">
                    <Trans message="home.hero.subtitle">
                        <a slot="selfHost" href={localizedHref(locale, '/install')} class="underline decoration-1 underline-offset-1">{t('home.hero.selfHost')}</a>
                    </Trans>
                </h2>
                <p class="mt-4 text-xl">
                    {t('home.hero.eu')}
                </p>
                <p class="mt-2 text-lg text-gray-400 dark:text-gray-500">
                    {t('home.hero.tagline')}
                </p>
            </div>

            <CloudOrSelfHosted/>

            <div class="w-full max-w-6xl">
                <div class="slider aspect-w-16 aspect-h-9 relative mt-8">
					{carouselImages.map(({src, darkSrc, alt}) => (
                            <Screenshot
                                    src={src}
                                    darkSrc={darkSrc}
                                    class=""
                                    alt={alt}
                            />
					))}
                </div>

                <div class="mt-36 mb-4 text-left md:flex px-4 md:px-6">
                    <div class="mt-4 md:mr-4 md:w-1/3">
                        <h2 class="flex items-center font-display text-2xl">
                            <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="mr-2 h-6 w-6 text-gray-500 dark:text-gray-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                            >
                                <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                />
                            </svg>
                            {t('home.ownData.title')}
                        </h2>
                        <p class="pt-4">
                            {t('home.ownData.text')}
                        </p>
                    </div>
                    <div class="mt-4 md:mr-4 md:w-1/3">
                        <h2 class="flex items-center font-display text-2xl">
                            <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="mr-2 h-6 w-6 text-gray-500 dark:text-gray-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                            >
                                <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                />
                            </svg>
                            {t('home.team.title')}
                        </h2>
                        <p class="pt-4">
                            {t('home.team.text')}
                        </p>
                    </div>
                    <div class="mt-4 md:w-1/3">
                        <h2 class="flex items-center font-display text-2xl">
                            <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="mr-2 h-6 w-6 text-gray-500 dark:text-gray-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                            >
                                <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
                                />
                            </svg>
                            {t('home.views.title')}
                        </h2>
                        <p class="pt-4">
                            {t('home.views.text')}
                        </p>
                    </div>
                </div>

                <p class="mt-16 text-center text-lg text-gray-500 dark:text-gray-400">
                    {t('home.import.question')}
                    <a href={localizedHref(locale, '/help/import-and-export/#import')} class="underline underline-offset-2">{t('home.import.link')}</a>
                </p>
            </div>
        </section>

        <div class="w-full max-w-3xl mt-16 mb-24 px-4 mx-auto text-balance">
            <span class="text-4xl font-display">
                {t('home.quote.title')}
            </span>
            <blockquote class="mt-6 text-lg italic">
                {t('home.quote.why')}<br/>
                {t('home.quote.cloud')}
            </blockquote>
            <p class="mt-4">
                <strong>Konrad</strong><br/>
                <i>{t('home.quote.role')}</i>
            </p>
        </div>

        <FAQSection />

        <section class="mx-auto mb-16 flex w-full max-w-6xl flex-col px-4 md:px-2 gap-4 text-left md:flex-row">
            <LinkCard
                    href={localizedHref(locale, '/install')}
                    image={HeroLlama1}
                    alt={t('home.card.install.alt')}
            >
                {t('home.card.install')}
            </LinkCard>
            <LinkCard
                    href={localizedHref(locale, '/features')}
                    image={HeroLlama2}
                    alt={t('home.card.features.alt')}
            >
                {t('home.card.features')}
            </LinkCard>
            <LinkCard
                    href={`${VIKUNJA_CLOUD_LINK}&utm_source=io&utm_medium=io&utm_campaign=menu`}
                    image={HeroLlama3}
                    alt={t('home.card.hosted.alt')}
            >
                {t('footer.getHosted')}
            </LinkCard>
        </section>

        <script>
			document.addEventListener('DOMContentLoaded', () => {
				const sliders = document.getElementsByClassName('slider')

				if (sliders) {
					for (const slider of sliders) {
						let current = 0
						const children = Array.from(slider.children)
						const sliderDuration = 5000

						const slide = () => {
							children.forEach((img, key) => {
								if (current !== key) {
									img.classList.remove('opacity-100')
									img.classList.add('opacity-0')
								} else {
									img.classList.add('opacity-100')
									img.classList.remove('opacity-0')
								}
							})

							current++
							if (current >= children.length) {
								current = 0
							}
						}

						// Loop through the images
						slide()
						setInterval(slide, sliderDuration)
					}
				}
			})
        </script>
    </main>
</Layout>

<style>
    @reference '../../styles/global.css';

    .slider > :global(*) {
        @apply absolute left-0 top-0 right-0 w-full transition-all duration-300 ease-in-out;
    }

    .slider picture {
        @apply w-full object-contain object-top shadow-lg;
    }
</style>
