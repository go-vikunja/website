---
import {marked} from 'marked'
import {VIKUNJA_CLOUD_LINK} from '../helpers/vikunjaCloudLink'
import {useTranslations} from '../i18n'
import {localizedHref, parsePathname} from '../i18n/routes'

interface Props {
	faqs?: {question: string, answer: string}[]
	showTitle?: boolean
}

const {locale} = parsePathname(Astro.url.pathname)
const t = useTranslations(locale)
const links = {cloudLink: VIKUNJA_CLOUD_LINK, installUrl: localizedHref(locale, '/install')}
const defaultFaqs = (['whatIs', 'free', 'install', 'selfHost', 'import'] as const).map(id => ({
	question: t(`faq.${id}.question`),
	answer: t(`faq.${id}.answer`, links),
}))

const {faqs = defaultFaqs, showTitle = true} = Astro.props

const parsedFaqs = faqs.map(faq => ({
	...faq,
	answerHtml: marked.parseInline(faq.answer) as string,
}))
---

<section class="w-full max-w-3xl mt-16 mb-24 px-4 mx-auto">
	{showTitle && <h2 class="text-3xl font-display mb-8">{t('faq.title')}</h2>}
	{parsedFaqs.map((faq, index) => (
		<details class:list={['faq-item group', index > 0 && 'border-t border-gray-200 dark:border-gray-700']}>
			<summary class="flex cursor-pointer items-center justify-between py-5 text-lg font-display list-none [&::-webkit-details-marker]:hidden">
				{faq.question}
				<svg class="size-5 shrink-0 transition-transform duration-200 group-open:rotate-45" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
				</svg>
			</summary>
			<div class="faq-content grid">
				<div class="overflow-hidden">
					<p class="pb-5 text-gray-600 dark:text-gray-400 [&_a]:underline [&_a]:text-primary" set:html={faq.answerHtml} />
				</div>
			</div>
		</details>
	))}
</section>

<style>
	.faq-content {
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.2s ease-out;
	}

	.faq-item[open] .faq-content {
		grid-template-rows: 1fr;
	}
</style>

<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": parsedFaqs.map(faq => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answerHtml.replace(/<[^>]*>/g, ''),
		},
	})),
})}></script>
